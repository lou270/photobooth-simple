# Written by install.sh (AUTOSTART): the session photobooth.service opens on
# tty1. systemd opens it as ${PHOTOBOOTH_USER} without authenticating, so no
# password is asked; pam_systemd has to register it with logind, or cage gets
# neither the screen nor the touchscreen.
auth     required pam_unix.so
account  required pam_unix.so
session  required pam_unix.so
session  required pam_systemd.so
