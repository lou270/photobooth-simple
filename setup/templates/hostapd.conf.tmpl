# PhotoBooth WiFi AP Configuration
#
# GENERATED by setup/apply-wifi.sh - edits here are lost on the next run.
# The network name and passphrase come from the [WiFi] section of config.ini,
# which is the single source of truth: the booth reads the same values to build
# the QR code guests scan, so the two can no longer disagree. Change the network
# in config.ini (or through the admin page) and re-run setup/apply-wifi.sh.

interface=${WIFI_INTERFACE}
driver=nl80211

# Network name (SSID)
ssid=${WIFI_SSID}

# WiFi channel (1-13)
channel=${WIFI_CHANNEL}

# WiFi mode (a=5GHz, g=2.4GHz)
hw_mode=g

# 802.11n support
ieee80211n=1

${HOSTAPD_SECURITY}

${HOSTAPD_HIDDEN}

# Regulatory domain, from WIFI_COUNTRY in setup/booth.conf
country_code=${WIFI_COUNTRY}

# Beacon interval
beacon_int=100

# DTIM period
dtim_period=2
