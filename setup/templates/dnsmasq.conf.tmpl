# PhotoBooth WiFi AP - DHCP/DNS/Captive Portal Configuration
#
# GENERATED by setup/apply-wifi.sh - edits here are lost on the next run.

interface=${WIFI_INTERFACE}
bind-interfaces
dhcp-authoritative
dhcp-range=${DHCP_RANGE_START},${DHCP_RANGE_END},255.255.255.0,24h
domain=photobooth.local

# Tell phones to use the PhotoBooth as gateway and DNS server.
# Without this, some phones keep routing through 4G/5G instead of opening the local portal.
dhcp-option=3,${WIFI_AP_ADDRESS}
dhcp-option=6,${WIFI_AP_ADDRESS}

# RFC 8910 captive portal hint, read by iOS 14+ and Android 11+. The URI must
# be the RFC 8908 API endpoint, which answers application/captive+json, and not
# a web page: a phone that finds HTML here ignores the hint and falls back to
# guessing from connectivity probes.
dhcp-option=114,http://${WIFI_AP_ADDRESS}/captive-portal/api

# Captive Portal DNS - resolve every domain to the PhotoBooth.
# Phones probe public domains to detect captive portals; this makes those probes hit Flask locally.
address=/#/${WIFI_AP_ADDRESS}

# Explicit captive portal probe domains kept for readability/debugging.
address=/captive.apple.com/${WIFI_AP_ADDRESS}
address=/www.apple.com/${WIFI_AP_ADDRESS}
address=/apple.com/${WIFI_AP_ADDRESS}
address=/connectivitycheck.gstatic.com/${WIFI_AP_ADDRESS}
address=/clients3.google.com/${WIFI_AP_ADDRESS}
address=/msftconnecttest.com/${WIFI_AP_ADDRESS}
address=/www.msftconnecttest.com/${WIFI_AP_ADDRESS}
address=/msftncsi.com/${WIFI_AP_ADDRESS}
address=/www.msftncsi.com/${WIFI_AP_ADDRESS}
address=/detectportal.firefox.com/${WIFI_AP_ADDRESS}
address=/nmcheck.gnome.org/${WIFI_AP_ADDRESS}

# Query logging, useful when a phone will not open the portal. Set
# WIFI_LOG_QUERIES=no in setup/booth.conf for a quiet production booth.
${DNSMASQ_LOGGING}
