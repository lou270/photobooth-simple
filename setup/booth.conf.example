# PhotoBooth machine profile - the answers install.sh used to ask one by one.
#
# Copy to setup/booth.conf, adjust, then build the booth without touching a
# keyboard:
#
#     ./install.sh --profile setup/booth.conf --yes
#
# An interactive run (./install.sh with no profile) writes its answers here at
# the end, so the second booth costs one command instead of seven questions.
#
# This file describes the HARDWARE and what to install. It deliberately holds no
# password and no printer name: those live in config.ini, which the application
# reads and the admin page rewrites. One value, one place.
#
# Nothing here sets up the guests' network either: the booth joins one like any
# other machine, and guests reach it there. The one network it can create is
# the debug hotspot below, for the operator. See INSTALLATION.md.

# --- Screen and kiosk -------------------------------------------------------

# Hide the cursor, the taskbar and the removable-media dialog, so the booth
# shows the application and nothing else. Needs Wayfire (Raspberry Pi OS
# desktop); the pieces that need it are skipped elsewhere.
KIOSK=yes

# Panel wired to HDMI. ingcool7 writes the 1024x600 timings the Ingcool 7"
# touchscreen needs; none leaves the display alone, which is what a mini PC or
# any monitor that negotiates its own mode wants.
#   ingcool7 | none
SCREEN=ingcool7

# --- Cameras (both may be enabled: preview on one, capture on the other) -----

# Raspberry Pi Camera Module V3: imx708 overlay plus the CMA bump libcamera
# needs. Requires a Pi; skipped when there is no firmware config file.
CAMERA_PICAMERA=no

# DSLR over USB through libgphoto2.
CAMERA_DSLR=yes

# Build libgphoto2 from source instead of using the distribution packages.
# Only worth it for a camera too recent for the packaged version - it pulls a
# third-party script off the internet and runs it as root, so it stays opt-in.
GPHOTO2_UPDATER=no

# A plain USB webcam needs nothing here: OpenCV is already in requirements.txt.

# --- Printer ----------------------------------------------------------------

# Install CUPS, list the printers it can reach and register the one chosen as
# the queue 'photobooth', which config.ini's PRINTER then names. Unattended
# (--yes), the first one found is taken, a USB printer before a network one.
# Leave PRINTER_URI empty for that, or pin a device URI (see `sudo lpinfo -v`).
# A Gutenprint printer gets Gutenprint's driver for its model.
PRINTER_SETUP=yes
PRINTER_URI=

# PPD for a printer Gutenprint does not drive, relative to the project root.
# Used only for the model in its file name.
PRINTER_PPD=doc/DS620.ppd

# --- Ring light -------------------------------------------------------------

# WS2812 ring on SPI0 (DIN to GPIO 10 / pin 19). Enables the SPI overlay and
# installs spidev.
LED_RING=yes

# --- Autostart --------------------------------------------------------------

# Start the booth at boot straight from the console, alone on the screen (in
# cage), and restart it on crash. The desktop, if there is one, is no longer
# started: no taskbar, update notice or dialog can draw over the booth. USB
# drives are mounted for the photo dump. Needs systemd; works on any Linux,
# Raspberry Pi OS Lite included.
AUTOSTART=yes

# --- Boot splash ------------------------------------------------------------

# Show the welcome picture instead of kernel messages while the booth starts:
# a Plymouth theme built from config.ini, the kernel told to be quiet (Pi
# cmdline.txt, or a GRUB drop-in on a mini PC), and the same picture as desktop
# wallpaper. The picture is baked in at install time: re-run the installer after
# changing the welcome photo.
BOOT_SPLASH=yes

# --- Debug hotspot ----------------------------------------------------------

# Turn the WiFi into a small network of the booth's own, for a laptop: join it,
# then `ssh <user>@10.42.0.1`, or open http://10.42.0.1 for the web pages,
# wherever the booth stands and whatever state the guests' network is in. It is
# for the operator only: no QR code points at it. The WiFi then belongs to the
# hotspot, so the booth reaches the guests' network - and the internet, for
# updates - through its ethernet port, and a laptop on the hotspot reaches them
# through the booth. Needs NetworkManager (Raspberry Pi OS Bookworm and later).
# The password is generated on the first run and printed once; NetworkManager
# keeps it, not this file.
DEBUG_HOTSPOT=yes

# Network name, in quotes if it has spaces. Empty: this machine's hostname
# followed by -debug.
DEBUG_HOTSPOT_SSID=

# Country the WiFi is used in, which decides the channels it may use.
DEBUG_HOTSPOT_COUNTRY=FR
