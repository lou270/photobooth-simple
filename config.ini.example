[Global]
# Interface language: the booth's screen, and the admin web pages. Guests on
# their own phone (gallery, send-a-photo page) instead get whatever language
# their phone asks for, independently of this setting. Available: en, fr
LANGUAGE = en

# If set to True, the window fill be fullscren
FULLSCREEN = False

# If set to True, the SHARE buttons and the WiFi QR code are displayed in the UI.
# Leave it False when guests are not meant to reach the gallery during an event:
# the booth then shows no QR code pointing at a server they cannot use.
SHARE = False

# If set to True, RingLed will be enabled (requires spidev hardware)
RINGLED = True

# Password protecting the admin pages: config editor, template editor, log viewer
# and deletion of every saved session. Use None to keep admin access disabled.
# Must be at least 10 characters and not a well-known value, otherwise admin
# access stays disabled and a message is written to the log.
ADMIN_PASSWORD = None

[Web]
# Port used by the gallery and admin web server
WEB_PORT = 5000

# Address the web server binds to.
# 0.0.0.0    reachable from every network the booth is attached to
# 127.0.0.1  local only, nothing reachable from the network
# 192.168.x.y pinned to a single interface
WEB_HOST = 0.0.0.0

[WiFi]
# The access point install.sh sets up on the Pi, as it must appear in the QR
# code guests scan to join it. Nothing here configures hostapd: these values
# only describe it, so renaming the network in /etc/hostapd/hostapd.conf means
# renaming it here as well, otherwise the QR code joins a network that is gone.
WIFI_SSID = PhotoBooth

# Empty for an open network, which is what install.sh configures. Fill it in
# after uncommenting wpa_passphrase in hostapd.conf.
WIFI_PASSWORD =

# True only if hostapd is set to ignore_broadcast_ssid
WIFI_HIDDEN = False

# The booth's own address on that access point, and the one every QR code hands
# to a phone. It cannot be guessed: the access point carries no default route on
# purpose, so the interface the system would pick is the venue's network, not
# the one guests are standing on. Must match the address install.sh gives wlan0.
# Leave empty for a booth that sits on somebody else's WiFi instead.
WIFI_AP_ADDRESS = 192.168.4.1

[Remote]
# Turn every guest phone into a camera for the booth: the welcome screen shows a
# QR code, the phone opens a page, takes a photo and sends it here. The photos
# wait in a queue the booth displays, and a guest prints the one they want.
REMOTE_CAPTURE = False

# Address the QR code points at. None derives it from the interface the booth
# answers on, which is what you want on its own access point. Set it by hand
# when the booth sits behind a captive portal name or a port forward, and give
# the whole address, port included: photobooth.local:5000
REMOTE_URL = None

# Largest upload accepted, in megabytes
REMOTE_MAX_UPLOAD_MB = 12

# Longest side kept when an incoming photo is re-encoded. Above the print
# resolution there is nothing to gain and a lot of disk to lose.
REMOTE_MAX_IMAGE_PIXELS = 2400

# How many photos one phone may leave waiting, and how many the queue holds in
# total. Both are there so one guest cannot fill the booth on their own.
REMOTE_MAX_PER_SENDER = 20
REMOTE_MAX_PENDING = 200

# Seconds a phone must wait between two sends
REMOTE_MIN_UPLOAD_INTERVAL = 3

[Log]
# Keep logs bounded for long unattended runs
LOG_RETENTION_DAYS = 14
LOG_MAX_FILES = 40

[Capture]
# Capture backend: auto, gphoto2, picamera2, opencv, fake
# auto  = probe every backend and pick the best combination (slower startup)
# fake  = synthetic camera, runs the app with no hardware at all (development/tests)
# Naming the backend explicitly makes startup faster and predictable on a known machine.
CAMERA = auto

# Countdown before the photo is taken
COUNTDOWN = 5

# If using a different camera for preview and capture,
# run tools/calibration_zoom.py to find the correct tuple to apply (zoom, offset_x, offset_y), None to disable
CALIBRATION = None

# If set to True, photo filters selection will be enabled on confirm screen
FILTERS = False

# Recompute blurred preview borders only every N frames to reduce CPU usage.
# 1 = recompute every frame, 3 = reuse the same blur for 2 frames before refreshing.
PREVIEW_BLUR_REFRESH_FRAMES = 3

# Add blurry borders to camera preview, captured images, and collages.
BLUR_CAMERA = True
BLUR_IMAGES = False
BLUR_COLLAGE = False

[Storage]
# Directory in which the photos and collages are stored
DCIM_DIRECTORY = ./DCIM

# Stop new sessions before storage failures become likely
DISK_MIN_FREE_GB = 2.0
DISK_MAX_USED_PERCENT = 90.0

[Print]
# The printer's name in CUPS (None to disable)
PRINTER = DS620

# Maximum number of prints allowed (None for unlimited)
MAX_PRINTS = None

# Seconds to wait for printer recovery before continuing without printing
PRINTER_WAIT_TIMEOUT = 45

[USB]
# Copy saved sessions to removable USB media when inserted
USB_EXPORT = True
USB_MIN_FREE_GB = 1.0

[DSLR_Liveview]
# Parameters applied to the DSLR during liveview (preview).
# Leave empty or None to leave the camera setting unchanged.
SHUTTERSPEED =
APERTURE =
FOCUSMODE =
ISO =

[DSLR_Capture]
# Parameters applied to the DSLR right before each photo capture.
# Leave empty or None to leave the setting unchanged.
SHUTTERSPEED = 1/125
APERTURE = 13
FOCUSMODE = One Shot
ISO = 100
